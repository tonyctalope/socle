# Origin of the control plane: sign-in, home page, sign-on towards the apps (https, no trailing slash).
CONTROL_URL=https://socle.example.com

# Apps are served on https://<app>.APPS_DOMAIN. Needs a wildcard DNS record and a
# wildcard certificate for *.APPS_DOMAIN. CONTROL_URL must not be inside it.
APPS_DOMAIN=apps.example.com

# Sign-in: any OpenID Connect provider (Google, Microsoft, Keycloak, Authentik, Pocket ID…).
# Create a "web application" client there, with this authorized redirect URI:
#   ${CONTROL_URL}/auth/callback
# The provider must give a verified e-mail address (scopes: openid email profile).
# Google: OIDC_ISSUER=https://accounts.google.com, client created in the Google Cloud console
# (APIs & Services → Credentials → OAuth client ID).
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional: what the sign-in button calls the provider ("Sign in with Google").
# OIDC_NAME=Google

# Only these accounts can sign in (e-mail addresses, comma separated). Removing an address
# ends its sessions on the next request.
ALLOWED_EMAILS=me@example.com,you@example.org

# Who publishes apps and manages the instance (comma separated, each one also in ALLOWED_EMAILS).
# Default: the first address of ALLOWED_EMAILS.
# ADMIN_EMAILS=me@example.com

# Serves the built-in demo app on https://demo.APPS_DOMAIN (sign-in, install, notifications).
DEMO_APP=1

# Where the members live: "today" for the apps' server functions (default: UTC).
# APP_TIMEZONE=Europe/Paris

# Language of the platform's own pages and messages: en (default) or fr.
# APP_LOCALE=en

# Agents (MCP clients) sign in through the platform's own OAuth server. By default the only
# web clients accepted are Claude's; local clients (loopback redirects) always are.
# OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# OAUTH_CIMD_HOSTS=claude.ai,claude.com,anthropic.com

# Optional: Web Push keys. Generated and stored in the database when unset.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Deployment (compose.yaml): host of CONTROL_URL, the DNS-01 certificate resolver
# of your Traefik, and the owner of ./data.
# SOCLE_CONTROL_HOST=socle.example.com
# SOCLE_CERT_RESOLVER=letsencrypt
# SOCLE_UID=1000
# SOCLE_GID=1000

# RUNNER_SOCKET is set by compose.yaml: the runner (builds, server functions) is a second
# container reached through a Unix socket. Without it, and outside production, the server
# starts the runner's worker processes itself.

# Local development only (refused unless NODE_ENV=development and CONTROL_URL is a localhost name):
# NODE_ENV=development
# DEV_LOGIN=1
# CONTROL_URL=http://socle.localhost:8787
# APPS_DOMAIN=apps.localhost
